+.eyebrow > span { width: 24px; height: 2px; background: var(--action-primary); flex-shrink: 0; }
+.hero h1 { font-size: clamp(42px, 4.7vw, 67px); margin: 21px 0 24px; max-width: 620px; }
+.hero-lead { color: var(--text-secondary); font-size: 17px; line-height: 1.75; }
+.hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 24px; margin-top: 30px; }
+.button { display: inline-flex; align-items: center; justify-content: space-between; gap: 28px; padding: 15px 20px; min-height: 52px; border-radius: 6px; text-decoration: none; font-size: 14px; line-height: 1.5; font-weight: 650; }
+.button-primary { background: var(--action-primary); color: var(--text-on-action); }
+.button-primary:hover { background: var(--action-hover); }
+.button > span[aria-hidden] { font-size: 19px; line-height: 1; }
+.text-link { display: inline-flex; align-items: center; gap: 14px; padding-block: 10px; min-height: 44px; font-size: 14px; font-weight: 650; text-decoration: none; }
+.text-link:hover { text-decoration: underline; }
+.hero-footnote { color: var(--text-secondary); font-size: 12px; max-width: 340px; margin-top: 24px; line-height: 1.7; }
+.math-canvas { min-height: 465px; position: relative; overflow: hidden; background: var(--canvas); border: 1px solid var(--border); border-radius: 4px 64px 4px 4px; isolation: isolate; }
+.math-canvas::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(var(--grid) 1px, transparent 1px), linear-gradient(90deg, var(--grid) 1px, transparent 1px); background-size: 31px 31px; z-index: -1; }
+.canvas-caption { position: absolute; top: 27px; left: 25px; right: 24px; font-size: 10px; font-weight: 650; letter-spacing: .12em; color: var(--text-secondary); }
+.math-disc { position: absolute; width: 236px; height: 236px; top: 89px; left: calc(50% - 118px); display: grid; place-items: center; background: var(--action-primary); color: var(--text-on-action); border-radius: 50%; transform: rotate(-12deg); }
+.math-disc span { font-family: Georgia, serif; font-size: 106px; letter-spacing: -.1em; margin-left: -10px; margin-top: -12px; font-style: italic; }
+.math-orbit { width: 310px; height: 168px; border: 1px solid var(--text-secondary); position: absolute; left: calc(50% - 155px); top: 124px; border-radius: 50%; transform: rotate(37deg); z-index: 1; }
+.math-superscript { position: absolute; z-index: 2; top: 87px; right: 22px; padding: 8px 13px; font-family: Georgia, serif; font-size: 20px; background: var(--surface-card); border: 1px solid var(--border); transform: rotate(7deg); }
+.math-curve { position: absolute; inset: 92px 0 auto; width: 100%; height: 320px; z-index: 3; }
+.math-curve .axis { stroke: var(--text-secondary); stroke-width: 1; opacity: .7; }
