+  --grid: #EBD1DE; --canvas: #FCE7F1;
+  --inverse: #241921; --inverse-text: #FFF8FC; --inverse-muted: #D3BAC9; --inverse-accent: #F69BC6;
+  --sans: system-ui, 'Segoe UI', Arial, sans-serif;
+}
+:root[data-theme="dark"] {
+  color-scheme: dark;
