+  const dark = { ...light, ...Object.fromEntries([...css.match(/:root\[data-theme="dark"\] \{([\s\S]*?)\}/)[1].matchAll(/--([\w-]+): (#[0-9A-F]{6})/g)].map(match => [match[1], match[2]])) };
+  for (const [name, tokens] of [['claro', light], ['escuro', dark]]) {
